{
  "_comment": "OpenClaw MCP 配置 — 接入 QClaw Appshots 插件",

  "mcp": {
    "servers": {
      "qclaw-appshot": {
        "command": "python",
        "args": ["-m", "qclaw_appshots"],
        "transport": "stdio",
        "env": {
          "QCLAW_DAEMON_SOCK": "/tmp/qclaw-appshot.sock",
          "QCLAW_SNAPSHOT_DIR": "/Users/jane/snapshots"
        }
      }
    }
  },

  "tools": {
    "sandbox": {
      "tools": {
        "allow": [
          "qclaw-appshot_take_appshot",
          "qclaw-appshot_list_appshots",
          "qclaw-appshot_get_appshot",
          "qclaw-appshot_search_appshots",
          "qclaw-appshot_delete_appshot"
        ]
      }
    }
  }
}
