<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ScreenCaptureKit requires Screen Recording permission -->
    <key>com.apple.security.screen-recording</key>
    <true/>
    <!-- Accessibility API requires Accessibility permission -->
    <key>com.apple.security.device.accessibility</key>
    <true/>
</dict>
</plist>
